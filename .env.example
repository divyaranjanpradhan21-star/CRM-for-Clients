NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
DATABASE_URL=postgresql://crm:crm_dev_password@localhost:5432/crm?schema=public
REDIS_URL=redis://localhost:6379
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
JWT_REFRESH_SECRET=change-me-too-change-me-too-change-me-too
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=14
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
# Seed super admin (dev only; change immediately)
SEED_ADMIN_EMAIL=superadmin@example.com
SEED_ADMIN_PASSWORD=ChangeMe#12345
# Integrations: leave blank until you have credentials. Adapters report NOT_CONFIGURED.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
