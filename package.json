{
  "name": "crm",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:api": "npm run dev -w @crm/api",
    "start:api": "npm run start -w @crm/api",
    "build": "npm run build -w @crm/shared && npm run build -w @crm/api",
    "db:up": "docker compose up -d",
    "db:migrate": "npm run prisma:migrate -w @crm/api",
    "db:seed": "npm run prisma:seed -w @crm/api",
    "test": "npm test -w @crm/api"
  }
}
