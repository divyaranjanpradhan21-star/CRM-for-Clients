{
  "name": "crm",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:api": "npm run dev -w @crm/api",
    "dev:web": "npm run dev -w @crm/web",
    "dev": "npm run dev -w @crm/web",
    "start:api": "npm run start -w @crm/api",
    "start:web": "npm run preview -w @crm/web",
    "build:web": "npm run build -w @crm/web",
    "build": "npm run build -w @crm/shared && npm run build -w @crm/api && npm run build -w @crm/web",
    "prisma:generate": "prisma generate --schema=apps/api/prisma/schema.prisma",
    "db:up": "docker compose up -d",
    "db:migrate": "npm run prisma:migrate -w @crm/api",
    "db:seed": "npm run prisma:seed -w @crm/api",
    "test": "npm test -w @crm/api"
  },
  "prisma": {
    "schema": "apps/api/prisma/schema.prisma"
  },
  "dependencies": {
    "@types/node": "^22.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0"
  }
}


