// CRM schema. Conventions:
//  - uuid PKs, organizationId on every tenant table (isolation enforced in the Prisma tenant extension, Phase 2)
//  - createdById/updatedById are plain uuid columns (no FK) so user deletion/anonymisation never blocks history;
//    business relations (assignee, owner, etc.) are real foreign keys.
//  - Money is Decimal(14,2). Soft delete via deletedAt on core entities.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────── Enums ─────────────
enum PermissionAction {
  VIEW
  CREATE
  EDIT
  DELETE
  ASSIGN
  EXPORT
  IMPORT
  APPROVE
}

enum PermissionScope {
  OWN
  TEAM
  ORG
  ALL
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum FollowupType {
  PHONE_CALL
  WHATSAPP
  EMAIL
  MEETING
  VIDEO_CALL
  OTHER
}

enum FollowupStatus {
  PENDING
  COMPLETED
  RESCHEDULED
  CANCELLED
  MISSED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  CHURNED
}

enum DealStatus {
  OPEN
  WON
  LOST
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMode {
  CASH
  BANK_TRANSFER
  UPI
  CARD
  CHEQUE
  OTHER
}

enum CampaignType {
  EMAIL
  SMS
  WHATSAPP
  SOCIAL
  ADS
  EVENT
  OTHER
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_CUSTOMER
  RESOLVED
  CLOSED
}

enum CommunicationType {
  CALL_INCOMING
  CALL_OUTGOING
  EMAIL
  WHATSAPP
  SMS
  MEETING
  NOTE
}

enum EntityType {
  LEAD
  CLIENT
  DEAL
  QUOTATION
  INVOICE
  TASK
  TICKET
  CAMPAIGN
}

enum AssignmentStrategy {
  MANUAL
  ROUND_ROBIN
  WORKLOAD
  TEAM
  LOCATION
  SOURCE
  PRODUCT
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  BOOLEAN
  SELECT
  MULTISELECT
}

enum NotificationType {
  LEAD_NEW
  LEAD_ASSIGNED
  LEAD_REASSIGNED
  FOLLOWUP_NEW
  FOLLOWUP_UPCOMING
  FOLLOWUP_OVERDUE
  TASK_ASSIGNED
  TASK_DEADLINE
  DEAL_WON
  DEAL_LOST
  CLIENT_NEW
  INVOICE_DUE
  PAYMENT_RECEIVED
  SYSTEM
}

// ───────────── Tenancy, identity, RBAC ─────────────
model Organization {
  id         String    @id @default(uuid()) @db.Uuid
  name       String
  slug       String    @unique
  email      String?
  phone      String?
  address    String?
  city       String?
  state      String?
  country    String?   @default("IN")
  gstNumber  String?
  logoUrl    String?
  currency   String    @default("INR")
  timezone   String    @default("Asia/Kolkata")
  dateFormat String    @default("DD/MM/YYYY")
  language   String    @default("en")
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  users User[]
  roles Role[]
}

model User {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String?   @db.Uuid // null only for platform Super Admins
  email            String    @unique
  passwordHash     String
  firstName        String
  lastName         String?
  phone            String?
  avatarUrl        String?
  roleId           String    @db.Uuid
  isActive         Boolean   @default(true)
  emailVerifiedAt  DateTime?
  twoFactorEnabled Boolean   @default(false)
  twoFactorSecret  String?
  lastLoginAt      DateTime?
  passwordChangedAt DateTime?
  resetTokenHash   String?
  resetTokenExpiresAt DateTime?
  verifyTokenHash  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdById      String?   @db.Uuid
  updatedById      String?   @db.Uuid
  deletedAt        DateTime?

  organization Organization? @relation(fields: [organizationId], references: [id])
  role         Role          @relation(fields: [roleId], references: [id])
  employee     Employee?
  refreshTokens RefreshToken[]
  loginHistory  LoginHistory[]
  teamMemberships TeamMember[]
  managedTeams    Team[]
  notifications   Notification[]
  notificationPrefs NotificationPreference[]
  leadsAssigned   Lead[]       @relation("LeadAssignedTo")
  followupsAssigned Followup[] @relation("FollowupAssignedTo")
  tasksAssigned   Task[]       @relation("TaskAssignedTo")
  clientsAssigned Client[]     @relation("ClientAssignedTo")
  dealsOwned      Deal[]       @relation("DealOwner")
  ticketsAssigned SupportTicket[] @relation("TicketAssignedTo")

  @@index([organizationId, roleId])
  @@index([organizationId, isActive])
}

model Role {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @db.Uuid // null = system-wide template role
  key            String
  name           String
  description    String?
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])
  users        User[]
  permissions  RolePermission[]

  @@unique([organizationId, key])
}

model Permission {
  id     String           @id @default(uuid()) @db.Uuid
  module String
  action PermissionAction

  roles RolePermission[]

  @@unique([module, action])
}

model RolePermission {
  roleId       String          @db.Uuid
  permissionId String          @db.Uuid
  scope        PermissionScope @default(OWN)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model RefreshToken {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  tokenHash   String    @unique
  familyId    String    @db.Uuid // rotation family; reuse of a revoked token revokes the family
  expiresAt   DateTime
  revokedAt   DateTime?
  userAgent   String?
  ip          String?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model LoginHistory {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  email     String
  success   Boolean
  reason    String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([email, createdAt])
}

// ───────────── People ─────────────
model Employee {
  id                 String    @id @default(uuid()) @db.Uuid
  organizationId     String    @db.Uuid
  userId             String    @unique @db.Uuid
  employeeCode       String
  department         String?
  designation        String?
  reportingManagerId String?   @db.Uuid
  joinedAt           DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  user     User       @relation(fields: [userId], references: [id])
  manager  Employee?  @relation("Reporting", fields: [reportingManagerId], references: [id])
  reports  Employee[] @relation("Reporting")

  @@unique([organizationId, employeeCode])
  @@index([organizationId, reportingManagerId])
}

model Team {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  name           String
  managerId      String?   @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  manager User?        @relation(fields: [managerId], references: [id])
  members TeamMember[]

  @@unique([organizationId, name])
}

model TeamMember {
  teamId String @db.Uuid
  userId String @db.Uuid

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([userId])
}

// ───────────── Configurable lookups ─────────────
model LeadSource {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  name           String
  isActive       Boolean @default(true)
  position       Int     @default(0)

  leads     Lead[]
  campaigns Campaign[]

  @@unique([organizationId, name])
}

model LeadStatus {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  name           String
  color          String  @default("#64748b")
  position       Int     @default(0)
  isWon          Boolean @default(false)
  isLost         Boolean @default(false)
  isActive       Boolean @default(true)

  leads Lead[]

  @@unique([organizationId, name])
}

model LeadCategory {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  name           String
  isActive       Boolean @default(true)

  leads Lead[]

  @@unique([organizationId, name])
}

// ───────────── Leads ─────────────
model Lead {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @db.Uuid
  leadCode        String
  name            String
  companyName     String?
  email           String?
  emailNormalized String?   // lowercased, for duplicate detection
  mobile          String?
  mobileE164      String?   // normalised, for duplicate detection
  whatsapp        String?
  alternatePhone  String?
  address         String?
  city            String?
  state           String?
  country         String?
  industry        String?
  designation     String?
  sourceId        String?   @db.Uuid
  categoryId      String?   @db.Uuid
  priority        Priority  @default(MEDIUM)
  estimatedBudget Decimal?  @db.Decimal(14, 2)
  interestedIn    String?
  description     String?
  assignedToId    String?   @db.Uuid
  statusId        String    @db.Uuid
  score           Int       @default(0)
  campaignId      String?   @db.Uuid
  customData      Json?
  lastContactedAt DateTime?
  nextContactAt   DateTime?
  mergedIntoId    String?   @db.Uuid
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdById     String?   @db.Uuid
  updatedById     String?   @db.Uuid
  deletedAt       DateTime?

  source     LeadSource?   @relation(fields: [sourceId], references: [id])
  category   LeadCategory? @relation(fields: [categoryId], references: [id])
  status     LeadStatus    @relation(fields: [statusId], references: [id])
  assignedTo User?         @relation("LeadAssignedTo", fields: [assignedToId], references: [id])
  campaign   Campaign?     @relation(fields: [campaignId], references: [id])
  mergedInto Lead?         @relation("LeadMerge", fields: [mergedIntoId], references: [id])
  mergedFrom Lead[]        @relation("LeadMerge")
  conversion ClientLeadConversion?

  assignments   LeadAssignment[]
  statusHistory LeadStatusHistory[]
  activities    LeadActivity[]
  notes         LeadNote[]
  tags          LeadTagMapping[]
  followups     Followup[]
  tasks         Task[]
  deals         Deal[]
  communications Communication[]

  @@unique([organizationId, leadCode])
  @@index([organizationId, assignedToId, statusId])
  @@index([organizationId, createdAt])
  @@index([organizationId, emailNormalized])
  @@index([organizationId, mobileE164])
  @@index([organizationId, sourceId])
  @@index([organizationId, deletedAt])
}

model LeadAssignment {
  id           String   @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  leadId       String   @db.Uuid
  fromUserId   String?  @db.Uuid
  toUserId     String   @db.Uuid
  assignedById String?  @db.Uuid // null = system / rule
  strategy     AssignmentStrategy @default(MANUAL)
  ruleId       String?  @db.Uuid
  reason       String?
  createdAt    DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@index([organizationId, toUserId])
}

model LeadStatusHistory {
  id           String   @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  leadId       String   @db.Uuid
  fromStatusId String?  @db.Uuid
  toStatusId   String   @db.Uuid
  changedById  String?  @db.Uuid
  note         String?
  createdAt    DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

model LeadActivity {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  leadId         String   @db.Uuid
  actorId        String?  @db.Uuid
  type           String   // CREATED, UPDATED, ASSIGNED, STATUS_CHANGED, NOTE, FOLLOWUP, CONVERTED, MERGED ...
  summary        String
  metadata       Json?
  createdAt      DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

model LeadNote {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  leadId         String    @db.Uuid
  body           String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdById    String?   @db.Uuid
  deletedAt      DateTime?

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

model LeadTag {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  name           String
  color          String @default("#6366f1")

  leads LeadTagMapping[]

  @@unique([organizationId, name])
}

model LeadTagMapping {
  leadId String @db.Uuid
  tagId  String @db.Uuid

  lead Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tag  LeadTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([leadId, tagId])
}

model AssignmentRule {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @db.Uuid
  name           String
  strategy       AssignmentStrategy
  priority       Int                @default(100) // lower runs first
  conditions     Json?              // e.g. { sourceIds: [], states: [], productIds: [] }
  config         Json?              // e.g. { userIds: [], teamId: "" }
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([organizationId, isActive, priority])
}

// ───────────── Follow-ups & tasks ─────────────
model Followup {
  id               String         @id @default(uuid()) @db.Uuid
  organizationId   String         @db.Uuid
  leadId           String?        @db.Uuid
  clientId         String?        @db.Uuid
  type             FollowupType   @default(PHONE_CALL)
  scheduledAt      DateTime
  assignedToId     String         @db.Uuid
  description      String?
  remarks          String?
  outcome          String?
  nextFollowupAt   DateTime?
  previousId       String?        @db.Uuid // chain: the follow-up that spawned this one
  reminderMinutesBefore Int?      @default(15)
  status           FollowupStatus @default(PENDING)
  completedAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  createdById      String?        @db.Uuid
  updatedById      String?        @db.Uuid
  deletedAt        DateTime?

  lead       Lead?     @relation(fields: [leadId], references: [id])
  client     Client?   @relation(fields: [clientId], references: [id])
  assignedTo User      @relation("FollowupAssignedTo", fields: [assignedToId], references: [id])
  previous   Followup? @relation("FollowupChain", fields: [previousId], references: [id])
  next       Followup[] @relation("FollowupChain")
  reminders  FollowupReminder[]

  @@index([organizationId, assignedToId, status, scheduledAt])
  @@index([organizationId, scheduledAt, status])
  @@index([leadId])
  @@index([clientId])
}

model FollowupReminder {
  id         String    @id @default(uuid()) @db.Uuid
  followupId String    @db.Uuid
  remindAt   DateTime
  sentAt     DateTime?

  followup Followup @relation(fields: [followupId], references: [id], onDelete: Cascade)

  @@index([remindAt, sentAt])
}

model Task {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @db.Uuid
  title          String
  description    String?
  category       String?
  priority       Priority   @default(MEDIUM)
  status         TaskStatus @default(PENDING)
  dueDate        DateTime?
  reminderAt     DateTime?
  reminderSentAt DateTime?
  assignedToId   String     @db.Uuid
  leadId         String?    @db.Uuid
  clientId       String?    @db.Uuid
  dealId         String?    @db.Uuid
  recurrenceRule String?    // iCal RRULE
  parentTaskId   String?    @db.Uuid
  completedAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  createdById    String?    @db.Uuid
  updatedById    String?    @db.Uuid
  deletedAt      DateTime?

  assignedTo User   @relation("TaskAssignedTo", fields: [assignedToId], references: [id])
  lead       Lead?  @relation(fields: [leadId], references: [id])
  client     Client? @relation(fields: [clientId], references: [id])
  deal       Deal?  @relation(fields: [dealId], references: [id])
  parent     Task?  @relation("TaskRecurrence", fields: [parentTaskId], references: [id])
  occurrences Task[] @relation("TaskRecurrence")
  comments   TaskComment[]

  @@index([organizationId, assignedToId, status, dueDate])
}

model TaskComment {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @db.Uuid
  authorId  String   @db.Uuid
  body      String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

// ───────────── Clients ─────────────
model Client {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  clientCode     String
  name           String
  companyName    String?
  email          String?
  emailNormalized String?
  phone          String?
  phoneE164      String?
  whatsapp       String?
  address        String?
  city           String?
  state          String?
  country        String?
  gstNumber      String?
  panNumber      String?
  category       String?
  clientType     String?
  status         ClientStatus @default(ACTIVE)
  assignedToId   String?      @db.Uuid
  onboardingDate DateTime?
  renewalDate    DateTime?
  lifetimeValue  Decimal      @default(0) @db.Decimal(14, 2)
  customData     Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  createdById    String?      @db.Uuid
  updatedById    String?      @db.Uuid
  deletedAt      DateTime?

  assignedTo User? @relation("ClientAssignedTo", fields: [assignedToId], references: [id])
  contacts   ClientContact[]
  documents  ClientDocument[]
  conversion ClientLeadConversion?
  followups  Followup[]
  tasks      Task[]
  deals      Deal[]
  quotations Quotation[]
  invoices   Invoice[]
  tickets    SupportTicket[]
  communications Communication[]

  @@unique([organizationId, clientCode])
  @@index([organizationId, assignedToId])
  @@index([organizationId, emailNormalized])
  @@index([organizationId, phoneE164])
  @@index([organizationId, renewalDate])
}

model ClientContact {
  id          String   @id @default(uuid()) @db.Uuid
  clientId    String   @db.Uuid
  name        String
  designation String?
  email       String?
  phone       String?
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model ClientDocument {
  id           String   @id @default(uuid()) @db.Uuid
  clientId     String   @db.Uuid
  attachmentId String   @unique @db.Uuid
  category     String?
  createdAt    DateTime @default(now())

  client     Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  attachment Attachment @relation(fields: [attachmentId], references: [id])

  @@index([clientId])
}

model ClientLeadConversion {
  id            String   @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  leadId        String   @unique @db.Uuid // one conversion per lead => no duplicate clients
  clientId      String   @unique @db.Uuid
  convertedById String?  @db.Uuid
  convertedAt   DateTime @default(now())
  leadSnapshot  Json     // lead state at conversion time

  lead   Lead   @relation(fields: [leadId], references: [id])
  client Client @relation(fields: [clientId], references: [id])
}

// ───────────── Pipeline & deals ─────────────
model Pipeline {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  name           String
  isDefault      Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  stages PipelineStage[]
  deals  Deal[]

  @@unique([organizationId, name])
}

model PipelineStage {
  id          String  @id @default(uuid()) @db.Uuid
  pipelineId  String  @db.Uuid
  name        String
  position    Int
  probability Int     @default(0) // 0-100
  isWon       Boolean @default(false)
  isLost      Boolean @default(false)

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals    Deal[]

  @@unique([pipelineId, name])
  @@index([pipelineId, position])
}

model Deal {
  id                String     @id @default(uuid()) @db.Uuid
  organizationId    String     @db.Uuid
  title             String
  pipelineId        String     @db.Uuid
  stageId           String     @db.Uuid
  clientId          String?    @db.Uuid
  leadId            String?    @db.Uuid
  ownerId           String     @db.Uuid
  teamId            String?    @db.Uuid
  value             Decimal    @default(0) @db.Decimal(14, 2)
  expectedCloseDate DateTime?
  probability       Int        @default(0)
  status            DealStatus @default(OPEN)
  lostReason        String?
  closedAt          DateTime?
  customData        Json?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  createdById       String?    @db.Uuid
  updatedById       String?    @db.Uuid
  deletedAt         DateTime?

  pipeline Pipeline      @relation(fields: [pipelineId], references: [id])
  stage    PipelineStage @relation(fields: [stageId], references: [id])
  client   Client?       @relation(fields: [clientId], references: [id])
  lead     Lead?         @relation(fields: [leadId], references: [id])
  owner    User          @relation("DealOwner", fields: [ownerId], references: [id])
  stageHistory DealStageHistory[]
  quotations   Quotation[]
  invoices     Invoice[]
  tasks        Task[]

  @@index([organizationId, pipelineId, stageId])
  @@index([organizationId, ownerId, status])
}

model DealStageHistory {
  id          String   @id @default(uuid()) @db.Uuid
  dealId      String   @db.Uuid
  fromStageId String?  @db.Uuid
  toStageId   String   @db.Uuid
  changedById String?  @db.Uuid
  createdAt   DateTime @default(now())

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId, createdAt])
}

// ───────────── Catalogue ─────────────
model Product {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  name           String
  sku            String
  category       String?
  description    String?
  price          Decimal   @db.Decimal(14, 2)
  taxPercent     Decimal   @default(0) @db.Decimal(5, 2)
  discountPercent Decimal  @default(0) @db.Decimal(5, 2)
  imageUrl       String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdById    String?   @db.Uuid
  updatedById    String?   @db.Uuid
  deletedAt      DateTime?

  quotationItems QuotationItem[]
  invoiceItems   InvoiceItem[]

  @@unique([organizationId, sku])
}

model Service {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  name           String
  code           String
  category       String?
  description    String?
  price          Decimal   @db.Decimal(14, 2)
  taxPercent     Decimal   @default(0) @db.Decimal(5, 2)
  discountPercent Decimal  @default(0) @db.Decimal(5, 2)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdById    String?   @db.Uuid
  updatedById    String?   @db.Uuid
  deletedAt      DateTime?

  quotationItems QuotationItem[]
  invoiceItems   InvoiceItem[]

  @@unique([organizationId, code])
}

// ───────────── Quotations, invoices, payments ─────────────
model Quotation {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  quotationNumber String
  clientId       String          @db.Uuid
  dealId         String?         @db.Uuid
  status         QuotationStatus @default(DRAFT)
  issueDate      DateTime        @default(now())
  validUntil     DateTime
  subtotal       Decimal         @default(0) @db.Decimal(14, 2)
  discountTotal  Decimal         @default(0) @db.Decimal(14, 2)
  taxTotal       Decimal         @default(0) @db.Decimal(14, 2)
  grandTotal     Decimal         @default(0) @db.Decimal(14, 2)
  terms          String?
  notes          String?
  sentAt         DateTime?
  respondedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  createdById    String?         @db.Uuid
  updatedById    String?         @db.Uuid
  deletedAt      DateTime?

  client   Client  @relation(fields: [clientId], references: [id])
  deal     Deal?   @relation(fields: [dealId], references: [id])
  items    QuotationItem[]
  invoices Invoice[]

  @@unique([organizationId, quotationNumber])
  @@index([organizationId, status, validUntil])
  @@index([clientId])
}

model QuotationItem {
  id          String   @id @default(uuid()) @db.Uuid
  quotationId String   @db.Uuid
  productId   String?  @db.Uuid
  serviceId   String?  @db.Uuid
  description String
  quantity    Decimal  @db.Decimal(12, 3)
  unitPrice   Decimal  @db.Decimal(14, 2)
  discountPercent Decimal @default(0) @db.Decimal(5, 2)
  taxPercent  Decimal  @default(0) @db.Decimal(5, 2)
  lineTotal   Decimal  @db.Decimal(14, 2)
  position    Int      @default(0)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product?  @relation(fields: [productId], references: [id])
  service   Service?  @relation(fields: [serviceId], references: [id])

  @@index([quotationId])
}

model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  invoiceNumber  String
  clientId       String        @db.Uuid
  quotationId    String?       @db.Uuid
  dealId         String?       @db.Uuid
  status         InvoiceStatus @default(DRAFT)
  invoiceDate    DateTime      @default(now())
  dueDate        DateTime
  subtotal       Decimal       @default(0) @db.Decimal(14, 2)
  discountTotal  Decimal       @default(0) @db.Decimal(14, 2)
  taxTotal       Decimal       @default(0) @db.Decimal(14, 2)
  totalAmount    Decimal       @default(0) @db.Decimal(14, 2)
  paidAmount     Decimal       @default(0) @db.Decimal(14, 2)
  pendingAmount  Decimal       @default(0) @db.Decimal(14, 2)
  terms          String?
  notes          String?
  lastReminderAt DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  createdById    String?       @db.Uuid
  updatedById    String?       @db.Uuid
  deletedAt      DateTime?

  client    Client     @relation(fields: [clientId], references: [id])
  quotation Quotation? @relation(fields: [quotationId], references: [id])
  deal      Deal?      @relation(fields: [dealId], references: [id])
  items     InvoiceItem[]
  payments  Payment[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, status, dueDate])
  @@index([clientId])
}

model InvoiceItem {
  id          String   @id @default(uuid()) @db.Uuid
  invoiceId   String   @db.Uuid
  productId   String?  @db.Uuid
  serviceId   String?  @db.Uuid
  description String
  quantity    Decimal  @db.Decimal(12, 3)
  unitPrice   Decimal  @db.Decimal(14, 2)
  discountPercent Decimal @default(0) @db.Decimal(5, 2)
  taxPercent  Decimal  @default(0) @db.Decimal(5, 2)
  lineTotal   Decimal  @db.Decimal(14, 2)
  position    Int      @default(0)

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])
  service Service? @relation(fields: [serviceId], references: [id])

  @@index([invoiceId])
}

model Payment {
  id            String      @id @default(uuid()) @db.Uuid
  organizationId String     @db.Uuid
  invoiceId     String      @db.Uuid
  amount        Decimal     @db.Decimal(14, 2)
  mode          PaymentMode
  paidAt        DateTime    @default(now())
  reference     String?
  notes         String?
  receiptNumber String
  receivedById  String?     @db.Uuid
  createdAt     DateTime    @default(now())
  voidedAt      DateTime?   // payments are voided, never hard-deleted

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@unique([organizationId, receiptNumber])
  @@index([invoiceId])
  @@index([organizationId, paidAt])
}

// ───────────── Marketing & support ─────────────
model Campaign {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  name           String
  type           CampaignType
  sourceId       String?        @db.Uuid
  status         CampaignStatus @default(DRAFT)
  budget         Decimal        @default(0) @db.Decimal(14, 2)
  spent          Decimal        @default(0) @db.Decimal(14, 2)
  startDate      DateTime?
  endDate        DateTime?
  description    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  createdById    String?        @db.Uuid
  updatedById    String?        @db.Uuid
  deletedAt      DateTime?

  source LeadSource? @relation(fields: [sourceId], references: [id])
  leads  Lead[]

  @@index([organizationId, status])
}

model SupportTicket {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @db.Uuid
  ticketCode      String
  clientId        String       @db.Uuid
  subject         String
  description     String
  category        String?
  priority        Priority     @default(MEDIUM)
  status          TicketStatus @default(OPEN)
  assignedToId    String?      @db.Uuid
  firstResponseAt DateTime?
  resolvedAt      DateTime?
  resolutionNotes String?
  feedbackRating  Int?
  feedbackComment String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  createdById     String?      @db.Uuid
  updatedById     String?      @db.Uuid
  deletedAt       DateTime?

  client     Client  @relation(fields: [clientId], references: [id])
  assignedTo User?   @relation("TicketAssignedTo", fields: [assignedToId], references: [id])
  comments   TicketComment[]

  @@unique([organizationId, ticketCode])
  @@index([organizationId, assignedToId, status])
}

model TicketComment {
  id         String   @id @default(uuid()) @db.Uuid
  ticketId   String   @db.Uuid
  authorId   String?  @db.Uuid
  body       String
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

// ───────────── Communication ─────────────
model Communication {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  type           CommunicationType
  leadId         String?           @db.Uuid
  clientId       String?           @db.Uuid
  subject        String?
  notes          String?
  outcome        String?
  durationSec    Int?
  occurredAt     DateTime          @default(now())
  nextContactAt  DateTime?
  provider       String?           // adapter name when sent via integration
  providerStatus String?           // SENT / FAILED / NOT_CONFIGURED
  externalId     String?
  createdAt      DateTime          @default(now())
  createdById    String?           @db.Uuid

  lead   Lead?   @relation(fields: [leadId], references: [id])
  client Client? @relation(fields: [clientId], references: [id])

  @@index([organizationId, leadId, occurredAt])
  @@index([organizationId, clientId, occurredAt])
}

// ───────────── Platform ─────────────
model Notification {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String?          @db.Uuid
  userId         String           @db.Uuid
  type           NotificationType
  title          String
  body           String?
  entityType     EntityType?
  entityId       String?          @db.Uuid
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model NotificationPreference {
  id     String           @id @default(uuid()) @db.Uuid
  userId String           @db.Uuid
  type   NotificationType
  inApp  Boolean          @default(true)
  email  Boolean          @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
}

model Attachment {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @db.Uuid
  entityType     EntityType
  entityId       String     @db.Uuid
  category       String?
  fileName       String
  mimeType       String
  sizeBytes      Int
  storageKey     String     // opaque key; never a user-supplied path
  checksum       String?
  version        Int        @default(1)
  replacesId     String?    @db.Uuid
  uploadedById   String?    @db.Uuid
  createdAt      DateTime   @default(now())
  deletedAt      DateTime?

  clientDocument ClientDocument?

  @@index([organizationId, entityType, entityId])
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @db.Uuid
  userId         String?  @db.Uuid
  action         String   // e.g. lead.create, auth.login, export.leads
  entityType     String?
  entityId       String?
  before         Json?
  after          Json?
  ip             String?
  userAgent      String?
  requestId      String?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
  @@index([userId, createdAt])
}

model CustomField {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  entity         EntityType
  key            String
  label          String
  fieldType      CustomFieldType
  options        Json?
  required       Boolean         @default(false)
  position       Int             @default(0)
  isActive       Boolean         @default(true)

  @@unique([organizationId, entity, key])
}

model Setting {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  key            String
  value          Json

  @@unique([organizationId, key])
}

model EmailTemplate {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  key            String   // e.g. quotation_send, payment_reminder
  kind           String   @default("EMAIL") // EMAIL | NOTIFICATION | WHATSAPP | SMS
  subject        String?
  body           String
  isActive       Boolean  @default(true)
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, key, kind])
}

// Per-org atomic counters for LEAD-000123, INV-2026-0042, etc.
model Sequence {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  key            String // lead | client | quotation | invoice | receipt | ticket | employee
  scope          String @default("") // e.g. fiscal year for invoices
  value          Int    @default(0)

  @@unique([organizationId, key, scope])
}
